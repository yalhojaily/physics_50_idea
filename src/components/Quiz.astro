---
interface Props {
  q: string;
  options: string[];
  answer: number; // رقم الخيار الصحيح بدءًا من 0
  why: string;
}
const { q, options, answer, why } = Astro.props;
---

<div class="quiz" data-answer={answer}>
  <p class="q">{q}</p>
  <div class="opts">
    {options.map((o, i) => <button class="opt" data-i={i}>{o}</button>)}
  </div>
  <p class="why" hidden><strong class="verdict"></strong> {why}</p>
</div>

<style>
  .quiz {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 16px 18px; margin: 16px 0;
  }
  .q { margin: 0 0 10px; font-weight: 600; }
  .opts { display: grid; gap: 8px; }
  .opt {
    font: inherit; font-size: 16px; text-align: start; cursor: pointer;
    background: var(--surface-2); color: var(--text);
    border: 1px solid var(--line); border-radius: 10px; padding: 8px 14px;
  }
  .opt:hover:not(:disabled) { border-color: var(--accent); }
  .opt:disabled { cursor: default; }
  .opt.right { border-color: var(--good); background: color-mix(in srgb, var(--good) 18%, var(--surface-2)); }
  .opt.wrong { border-color: var(--bad); background: color-mix(in srgb, var(--bad) 15%, var(--surface-2)); }
  .why { margin: 12px 0 0; font-size: 16px; color: var(--muted); }
  .why strong { color: var(--text); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.quiz').forEach((quiz) => {
    const answer = Number(quiz.dataset.answer);
    const opts = [...quiz.querySelectorAll<HTMLButtonElement>('.opt')];
    const why = quiz.querySelector<HTMLElement>('.why')!;
    opts.forEach((b) =>
      b.addEventListener('click', () => {
        const ok = Number(b.dataset.i) === answer;
        opts.forEach((o) => (o.disabled = true));
        opts[answer].classList.add('right');
        if (!ok) b.classList.add('wrong');
        why.querySelector('.verdict')!.textContent = ok ? 'أحسنت.' : 'ليس تمامًا.';
        why.hidden = false;
      }),
    );
  });
</script>
