---
// مختبر القانون الثاني: انتشار الغاز، وتدفق الحرارة بين جسمين
import '../styles/lab.css';
import TimeControls from './TimeControls.astro';
---

<figure class="lab" id="entropyLab">
  <div class="tabs" role="tablist">
    <button class="tab" data-tab="spread" aria-selected="true">انتشار الغاز<small>هل يعود إلى نصفه؟</small></button>
    <button class="tab" data-tab="heat" aria-selected="false">تدفق الحرارة<small>من الساخن إلى البارد</small></button>
  </div>

  <canvas class="scene" aria-label="محاكاة الانتشار أو تدفق الحرارة"></canvas>
  <p class="caption" aria-live="polite"></p>

  <div class="controls">
    <TimeControls />

    <div class="pane" data-pane="spread">
      <div class="row">
        <span class="lbl">عدد الجزيئات N</span>
        <div class="chips">
          <button class="btn" data-n="4" aria-pressed="false">4</button>
          <button class="btn" data-n="10" aria-pressed="false">10</button>
          <button class="btn" data-n="40" aria-pressed="false">40</button>
          <button class="btn" data-n="150" aria-pressed="true">150</button>
        </div>
      </div>
      <div class="row">
        <button class="btn primary lift">⇡ ارفع الحاجز</button>
        <button class="btn back">↺ أعد الغاز إلى اليسار</button>
      </div>
    </div>

    <div class="pane" data-pane="heat" hidden>
      <div class="row">
        <span class="lbl">حجم الجسم B</span>
        <div class="chips">
          <button class="btn" data-nb="50" aria-pressed="true">مثل A</button>
          <button class="btn" data-nb="150" aria-pressed="false">ثلاثة أضعاف A</button>
        </div>
      </div>
      <div class="row">
        <button class="btn primary restart">↺ ابدأ: A ساخن وB بارد</button>
      </div>
    </div>

    <dl class="readouts"></dl>

    <div class="chart-wrap">
      <canvas class="chart" aria-label="تطور العدد أو الطاقة والإنتروبيا مع الزمن"></canvas>
      <p class="note chart-note"></p>
    </div>
  </div>
</figure>

<script>
  import { isolate } from '../scripts/bidi';
  import { Gas, K_SIM, speedColor } from '../scripts/gas';
  import { bindTimeControls } from '../scripts/timectl';

  type Tab = 'spread' | 'heat';
  const root = document.getElementById('entropyLab')!;
  const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
  const scene = $<HTMLCanvasElement>('.scene');
  const chart = $<HTMLCanvasElement>('.chart');
  const caption = $<HTMLElement>('.caption');
  const readouts = $<HTMLElement>('.readouts');
  const time = bindTimeControls(root);

  let tab: Tab = 'spread';

  // ——— أدوات رياضية ———
  /** لوغاريتم دالة غاما (تقريب لانشوس) */
  function lgamma(z: number): number {
    if (z < 0.5) return Math.log(Math.PI / Math.sin(Math.PI * z)) - lgamma(1 - z);
    const g = 7;
    const c = [0.99999999999980993, 676.5203681218851, -1259.1392167224028, 771.32342877765313, -176.61502916214059, 12.507343278686905, -0.13857109526572012, 9.9843695780195716e-6, 1.5056327351493116e-7];
    z -= 1;
    let x = c[0];
    for (let i = 1; i < g + 2; i++) x += c[i] / (z + i);
    const t = z + g + 0.5;
    return 0.5 * Math.log(2 * Math.PI) + (z + 0.5) * Math.log(t) - t + Math.log(x);
  }
  const lnChoose = (n: number, k: number) => lgamma(n + 1) - lgamma(k + 1) - lgamma(n - k + 1);
  /** عدد الحالات المجهرية لجسم صلب فيه N ذرة وq كمّة طاقة: C(q+N−1, q) */
  const lnOmega = (N: number, q: number) => lgamma(q + N) - lgamma(q + 1) - lgamma(N);
  const sci = (log10: number) => {
    if (log10 < 4) return Math.round(10 ** log10).toLocaleString('en-US');
    const e = Math.floor(log10);
    return `${(10 ** (log10 - e)).toFixed(1)}×10^${e}`;
  };

  // ——— الانتشار ———
  const gas = new Gas();
  let nSpread = 150;
  let lifted = false;
  let spreadT = 0;
  let spreadHist: { t: number; left: number }[] = [];
  let allLeftSeen = 0; // كم مرة عاد الغاز كله إلى اليسار

  function resetSpread() {
    gas.xw = gas.W;
    gas.thermostat = null;
    gas.fill(nSpread, 300, 0, gas.W / 2);
    gas.barrier = gas.W / 2;
    lifted = false;
    spreadT = 0;
    spreadHist = [];
    allLeftSeen = 0;
  }
  let wasAllLeft = true;
  function stepSpread(dt: number) {
    const n = Math.max(1, Math.ceil(dt / (1 / 300)));
    for (let i = 0; i < n; i++) gas.step(dt / n);
    spreadT += dt;
    const left = gas.countLeftOf(gas.W / 2);
    if (lifted) {
      const all = left === gas.n;
      if (all && !wasAllLeft) allLeftSeen++;
      wasAllLeft = all;
    }
    const lastT = spreadHist.length ? spreadHist[spreadHist.length - 1].t : -1;
    if (spreadT - lastT >= 0.05) {
      spreadHist.push({ t: spreadT, left });
      while (spreadHist.length && spreadT - spreadHist[0].t > 30) spreadHist.shift();
    }
  }

  // ——— تدفق الحرارة: جسمان صلبان من «مذبذبات» تتبادل كمّات الطاقة عشوائيًا ———
  const NA = 50;
  let NB = 50;
  let qs = new Int32Array(0); // كمّات كل ذرة: أولًا ذرات A ثم ذرات B
  let heatT = 0;
  let heatHist: { t: number; qA: number; S: number }[] = [];
  let flowAcc = 0; // صافي الكمّات المنتقلة من A إلى B منذ آخر قراءة
  let flowRate = 0;
  let eqReached = false; // بلغ الجسمان الاتزان (مع تخلّف حتى لا يتبدل الشرح)
  const Q_TOTAL = 400;
  const Q_A0 = 340;
  const RATE = 350; // تبادلات في الثانية من زمن المحاكاة

  function resetHeat() {
    qs = new Int32Array(NA + NB);
    // توزيع أولي عشوائي داخل كل جسم
    for (let k = 0; k < Q_A0; k++) qs[(Math.random() * NA) | 0]++;
    for (let k = 0; k < Q_TOTAL - Q_A0; k++) qs[NA + ((Math.random() * NB) | 0)]++;
    heatT = 0;
    heatHist = [];
    flowAcc = 0;
    flowRate = 0;
    eqReached = false;
  }
  const qA = () => { let s = 0; for (let i = 0; i < NA; i++) s += qs[i]; return s; };
  const Stot = (a: number) => lnOmega(NA, a) + lnOmega(NB, Q_TOTAL - a);
  let exAcc = 0;
  function stepHeat(dt: number) {
    exAcc += dt * RATE;
    const N = NA + NB;
    while (exAcc >= 1) {
      exAcc -= 1;
      const i = (Math.random() * N) | 0;
      if (qs[i] === 0) continue;
      const j = (Math.random() * N) | 0;
      qs[i]--; qs[j]++;
      if (i < NA && j >= NA) flowAcc++;
      else if (i >= NA && j < NA) flowAcc--;
    }
    heatT += dt;
    const lastT = heatHist.length ? heatHist[heatHist.length - 1].t : -1;
    if (heatT - lastT >= 0.05) {
      const a = qA();
      heatHist.push({ t: heatT, qA: a, S: Stot(a) });
      while (heatHist.length && heatT - heatHist[0].t > 30) heatHist.shift();
    }
    flowRate += (flowAcc / Math.max(dt, 1e-6) - flowRate) * Math.min(1, dt / 0.8);
    flowAcc = 0;
  }

  // ——— الرسم ———
  const fit = (c: HTMLCanvasElement) => {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const { width, height } = c.getBoundingClientRect();
    const W = Math.round(width * dpr), H = Math.round(height * dpr);
    if (c.width !== W || c.height !== H) { c.width = W; c.height = H; }
    const ctx = c.getContext('2d')!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.direction = 'ltr';
    return { ctx, w: width, h: height };
  };

  function drawSpread() {
    const { ctx, w, h } = fit(scene);
    ctx.fillStyle = '#0b1020';
    ctx.fillRect(0, 0, w, h);
    const ppm = Math.min((w - 40) / gas.W, (h - 60) / gas.H);
    const ox = (w - gas.W * ppm) / 2, oy = 34;
    const X = (x: number) => ox + x * ppm, Y = (y: number) => oy + y * ppm;
    ctx.fillStyle = '#141c3a';
    ctx.fillRect(X(0), Y(0), gas.W * ppm, gas.H * ppm);
    // خط المنتصف
    ctx.strokeStyle = gas.barrier !== null ? '#c9cfe4' : '#ffffff30';
    ctx.lineWidth = gas.barrier !== null ? 4 : 1.5;
    ctx.setLineDash(gas.barrier !== null ? [] : [6, 6]);
    ctx.beginPath(); ctx.moveTo(X(gas.W / 2), Y(0)); ctx.lineTo(X(gas.W / 2), Y(gas.H)); ctx.stroke();
    ctx.setLineDash([]);
    ctx.strokeStyle = '#c9cfe4';
    ctx.lineWidth = 2;
    ctx.strokeRect(X(0), Y(0), gas.W * ppm, gas.H * ppm);
    const kT = K_SIM * 300;
    const rad = nSpread <= 10 ? 7 : nSpread <= 40 ? 4.5 : 3;
    for (let i = 0; i < gas.n; i++) {
      ctx.fillStyle = speedColor(gas.vx[i] ** 2 + gas.vy[i] ** 2, kT);
      ctx.beginPath(); ctx.arc(X(gas.x[i]), Y(gas.y[i]), rad, 0, Math.PI * 2); ctx.fill();
    }
    const left = gas.countLeftOf(gas.W / 2);
    ctx.fillStyle = '#e8ecf8';
    ctx.font = '600 14px system-ui';
    ctx.textAlign = 'center';
    ctx.fillText(`${left}`, X(gas.W / 4), 22);
    ctx.fillText(`${gas.n - left}`, X((3 * gas.W) / 4), 22);
  }

  function drawHeat() {
    const { ctx, w, h } = fit(scene);
    ctx.fillStyle = '#0b1020';
    ctx.fillRect(0, 0, w, h);
    const gap = 60;
    const total = NA + NB;
    const usable = w - 40 - gap;
    const wA = (usable * NA) / total, wB = (usable * NB) / total;
    const top = 50, bh = h - 100;
    const block = (x0: number, bw: number, start: number, N: number, name: string) => {
      const cols = Math.max(1, Math.round(Math.sqrt((N * bw) / bh)));
      const rows = Math.ceil(N / cols);
      const cw = bw / cols, ch = bh / rows;
      for (let k = 0; k < N; k++) {
        const q = qs[start + k];
        const t = Math.min(1, q / 14);
        ctx.fillStyle = `rgb(${Math.round(30 + 210 * t)},${Math.round(40 + 120 * t * t)},${Math.round(80 - 40 * t)})`;
        const cx = x0 + (k % cols) * cw, cy = top + Math.floor(k / cols) * ch;
        ctx.fillRect(cx + 1, cy + 1, cw - 2, ch - 2);
      }
      ctx.strokeStyle = '#c9cfe4';
      ctx.lineWidth = 2;
      ctx.strokeRect(x0, top, bw, bh);
      let q = 0;
      for (let k = 0; k < N; k++) q += qs[start + k];
      ctx.fillStyle = '#e8ecf8';
      ctx.font = '700 15px system-ui';
      ctx.textAlign = 'center';
      ctx.fillText(name, x0 + bw / 2, top - 26);
      ctx.font = '12px system-ui';
      ctx.fillStyle = '#9aa5c8';
      ctx.fillText(`E = ${q}  ·  E/N = ${(q / N).toFixed(2)}`, x0 + bw / 2, top - 8);
    };
    const xA = 20, xB = 20 + wA + gap;
    block(xA, wA, 0, NA, 'A');
    block(xB, wB, NA, NB, 'B');
    // سهم صافي التدفق
    const mid = top + bh / 2;
    const ax0 = xA + wA + 8, ax1 = xB - 8;
    const mag = Math.min(1, Math.abs(flowRate) / 60);
    if (mag > 0.05) {
      const dir = Math.sign(flowRate);
      const a = dir > 0 ? ax0 : ax1, b = dir > 0 ? ax1 : ax0;
      ctx.strokeStyle = '#ffd166';
      ctx.fillStyle = '#ffd166';
      ctx.globalAlpha = 0.35 + 0.65 * mag;
      ctx.lineWidth = 2 + 6 * mag;
      ctx.beginPath(); ctx.moveTo(a, mid); ctx.lineTo(b - dir * 12, mid); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(b, mid); ctx.lineTo(b - dir * 14, mid - 10); ctx.lineTo(b - dir * 14, mid + 10); ctx.closePath(); ctx.fill();
      ctx.globalAlpha = 1;
    }
    ctx.fillStyle = '#9aa5c8';
    ctx.font = '12px system-ui';
    ctx.textAlign = 'center';
    ctx.fillText('حرارة', (ax0 + ax1) / 2, mid - 16);
  }

  function drawChart() {
    const { ctx, w, h } = fit(chart);
    ctx.clearRect(0, 0, w, h);
    const css = getComputedStyle(document.documentElement);
    const muted = css.getPropertyValue('--muted');
    const L = 40, B = 18, T = 8, R = 10;
    const hist = tab === 'spread' ? spreadHist : heatHist;
    const tNow = tab === 'spread' ? spreadT : heatT;
    const t0 = Math.max(0, tNow - 30);
    const X = (t: number) => L + ((t - t0) / 30) * (w - L - R);
    ctx.font = '11px system-ui';
    ctx.fillStyle = muted;
    ctx.strokeStyle = css.getPropertyValue('--line');
    ctx.lineWidth = 1;
    ctx.textAlign = 'center';
    for (let s = Math.ceil(t0 / 5) * 5; s <= t0 + 30; s += 5) {
      ctx.beginPath(); ctx.moveTo(X(s), T); ctx.lineTo(X(s), h - B); ctx.stroke();
      ctx.fillText(`${s}s`, X(s), h - 4);
    }
    if (tab === 'spread') {
      const N = gas.n;
      const Y = (v: number) => h - B - (v / N) * (h - B - T);
      ctx.textAlign = 'right';
      for (const f of [0, 0.5, 1]) ctx.fillText(`${Math.round(f * N)}`, L - 5, Y(f * N) + 4);
      ctx.strokeStyle = '#5ad19a';
      ctx.setLineDash([5, 5]);
      ctx.beginPath(); ctx.moveTo(L, Y(N / 2)); ctx.lineTo(w - R, Y(N / 2)); ctx.stroke();
      ctx.setLineDash([]);
      ctx.strokeStyle = '#f0a43a';
      ctx.lineWidth = 2.2;
      ctx.beginPath();
      (hist as typeof spreadHist).forEach((p, i) => (i ? ctx.lineTo(X(p.t), Y(p.left)) : ctx.moveTo(X(p.t), Y(p.left))));
      ctx.stroke();
    } else {
      const Y = (v: number) => h - B - (v / Q_TOTAL) * (h - B - T);
      ctx.textAlign = 'right';
      for (const f of [0, 0.5, 1]) ctx.fillText(`${Math.round(f * Q_TOTAL)}`, L - 5, Y(f * Q_TOTAL) + 4);
      // خط الاتزان: الطاقة تتوزع بنسبة عدد الذرات
      const eq = (Q_TOTAL * NA) / (NA + NB);
      ctx.strokeStyle = '#5ad19a';
      ctx.setLineDash([5, 5]);
      ctx.beginPath(); ctx.moveTo(L, Y(eq)); ctx.lineTo(w - R, Y(eq)); ctx.stroke();
      ctx.setLineDash([]);
      ctx.strokeStyle = '#f0a43a';
      ctx.lineWidth = 2.2;
      ctx.beginPath();
      (hist as typeof heatHist).forEach((p, i) => (i ? ctx.lineTo(X(p.t), Y(p.qA)) : ctx.moveTo(X(p.t), Y(p.qA))));
      ctx.stroke();
      // الإنتروبيا الكلية بمقياسها الخاص
      const sMax = Stot(Math.round(eq)), sMin = Stot(Q_A0) - 5;
      const YS = (s: number) => h - B - ((s - sMin) / (sMax - sMin)) * (h - B - T);
      ctx.strokeStyle = '#9b8cff';
      ctx.beginPath();
      (hist as typeof heatHist).forEach((p, i) => (i ? ctx.lineTo(X(p.t), YS(p.S)) : ctx.moveTo(X(p.t), YS(p.S))));
      ctx.stroke();
    }
  }

  // ——— النصوص ———
  let lastHtml = '';
  function updateText() {
    let cells: [string, string, boolean?][];
    let cap: string;
    if (tab === 'spread') {
      const N = gas.n, left = gas.countLeftOf(gas.W / 2);
      const pAll = -N * Math.log10(2);
      const sNow = lnChoose(N, left), sMax = lnChoose(N, Math.floor(N / 2));
      cells = [
        ['في اليسار / اليمين', `${left} / ${N - left}`, true],
        ['احتمال أن يكون الكل يسارًا', `1 / ${sci(-pAll)}`],
        ['طرق ترتيب الحالة الآن W', sci(sNow / Math.LN10)],
        ['W عند التساوي', sci(sMax / Math.LN10)],
      ];
      if (lifted) cells.push(['مرات عودة الكل إلى اليسار', `${allLeftSeen}`]);
      if (!lifted) cap = 'الغاز كله في النصف الأيسر خلف حاجز. ارفع الحاجز وراقب: هل يبقى في اليسار؟ وهل يعود إليه يومًا؟';
      else if (time.paused) cap = `لقطة: ${left} جزيئًا في اليسار و${N - left} في اليمين. لا قانون يمنع أي جزيء من العودة، لكن الحالات القريبة من التساوي أكثر عددًا بفارق هائل، فهي ما نراه في الغالب.`;
      else if (N <= 10) cap = `مع ${N} جزيئات فقط، يعود الغاز كله إلى اليسار بين حين وآخر: احتماله 1 من ${sci(-pAll)}. القانون الثاني إحصائي، ويظهر بوضوح فقط حين تكثر الجزيئات.`;
      else cap = `مع ${N} جزيئًا، احتمال أن تجتمع كلها يسارًا 1 من ${sci(-pAll)}. لن تراه ولو انتظرت عمر الكون. هكذا يصبح «غير المرجّح» مستحيلًا عمليًا.`;
    } else {
      const a = qA(), b = Q_TOTAL - a;
      const S = Stot(a), Smax = Stot(Math.round((Q_TOTAL * NA) / (NA + NB)));
      cells = [
        ['طاقة A لكل ذرة', (a / NA).toFixed(2), true],
        ['طاقة B لكل ذرة', (b / NB).toFixed(2), true],
        ['الحالات الممكنة Ω', sci(S / Math.LN10)],
        ['Ω عند الاتزان', sci(Smax / Math.LN10)],
      ];
      if (time.paused) cap = 'لقطة: كل مربع ذرة، ولونه يدل على طاقتها. لا شيء يدفع الطاقة نحو B؛ كل كمّة تقفز إلى ذرة عشوائية. لكن طرق توزيع الطاقة حين يتقاسمها الجسمان أكثر بكثير، فتنتهي هناك.';
      else if (!(eqReached ||= Math.abs(a / NA - b / NB) < 0.25)) cap = 'كمّات الطاقة تقفز عشوائيًا بين الذرات في الاتجاهين، لكن الصافي يتجه من A الساخن إلى B البارد. والخط البنفسجي (الإنتروبيا) يصعد.';
      else cap = 'وصل الجسمان إلى الاتزان: طاقة الذرة متساوية تقريبًا فيهما، أي أن حرارتهما واحدة. التبادل مستمر، لكنه متعادل. والإنتروبيا عند قمتها تقريبًا.';
    }
    const html = cells.map(([k, v, hl]) => `<div${hl ? ' class="hl"' : ''}><dt>${k}</dt><dd>${v}</dd></div>`).join('');
    if (html !== lastHtml) { readouts.innerHTML = html; lastHtml = html; }
    { const c = isolate(cap); if (caption.textContent !== c) caption.textContent = c; }
  }

  // ——— التفاعل ———
  function setTab(t: Tab) {
    tab = t;
    root.querySelectorAll<HTMLButtonElement>('.tab').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === t)));
    root.querySelectorAll<HTMLElement>('.pane').forEach((p) => (p.hidden = p.dataset.pane !== t));
    $<HTMLElement>('.chart-note').textContent = t === 'spread'
      ? 'عدد الجزيئات في النصف الأيسر مع الزمن. الخط المنقّط: نصف العدد.'
      : 'البرتقالي: طاقة A. المنقّط: نصيب A عند الاتزان. البنفسجي: الإنتروبيا الكلية (لوغاريتم عدد الحالات) بمقياسها الخاص.';
  }
  root.querySelectorAll<HTMLButtonElement>('.tab').forEach((b) => b.addEventListener('click', () => setTab(b.dataset.tab as Tab)));
  root.querySelectorAll<HTMLButtonElement>('[data-n]').forEach((b) =>
    b.addEventListener('click', () => {
      nSpread = Number(b.dataset.n);
      root.querySelectorAll<HTMLButtonElement>('[data-n]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      resetSpread();
    }),
  );
  root.querySelectorAll<HTMLButtonElement>('[data-nb]').forEach((b) =>
    b.addEventListener('click', () => {
      NB = Number(b.dataset.nb);
      root.querySelectorAll<HTMLButtonElement>('[data-nb]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      resetHeat();
    }),
  );
  $<HTMLButtonElement>('.lift').addEventListener('click', () => {
    gas.barrier = null;
    lifted = true;
    wasAllLeft = true;
    spreadT = 0;
    spreadHist = [];
    time.paused = false;
    time.sync();
  });
  $<HTMLButtonElement>('.back').addEventListener('click', resetSpread);
  $<HTMLButtonElement>('.restart').addEventListener('click', () => { resetHeat(); time.paused = false; time.sync(); });
  time.onStep = () => (tab === 'spread' ? stepSpread(0.2) : stepHeat(0.2));

  let visible = true;
  new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(root);
  let last = performance.now();
  function loop(now: number) {
    const dt = Math.max(0, Math.min(0.05, (now - last) / 1000));
    last = now;
    if (visible) {
      if (!time.paused) {
        if (tab === 'spread') stepSpread(dt * time.speed);
        else stepHeat(dt * time.speed);
      }
      if (tab === 'spread') drawSpread(); else drawHeat();
      drawChart();
      updateText();
    }
    requestAnimationFrame(loop);
  }
  resetSpread();
  resetHeat();
  setTab('spread');
  requestAnimationFrame(loop);
</script>
