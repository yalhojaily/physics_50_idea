---
// قالب ثابت لكل درس. يأخذ رقم الموضوع من رأس ملف MDX ويبني الباقي من topics.ts
import 'katex/dist/katex.min.css';
import Base from './Base.astro';
import { topicById, unitById, nextOf, lessonUrl, withBase, topics } from '../data/topics';

const fm = Astro.props.frontmatter ?? Astro.props;
const topic = topicById(Number(fm.id));
const unit = unitById(topic.unit);
const prereqs = topic.prereqs.map(topicById);
const next = nextOf(topic.id);
const prev = topics.find((t) => t.id === topic.id - 1);
const after = topics.find((t) => t.id === topic.id + 1);

const linkOrSpan = (t: (typeof topics)[number]) => ({ href: t.ready ? lessonUrl(t) : undefined, t });
---

<Base title={`${topic.title} — 50 فكرة في الفيزياء`} description={fm.idea}>
  <main class="lesson" style={`--c:${unit.color}`}>
    <header class="lesson-head">
      <div class="prose">
        <a class="back" href={withBase()}>→ الخريطة</a>
        <p class="meta"><span class="badge">{unit.title}</span> الفكرة {topic.id} من 50</p>
        <h1>{topic.title}</h1>
        <p class="en ltr">{topic.en}</p>
        <p class="idea"><span>الفكرة في جملة</span>{fm.idea}</p>
      </div>
    </header>

    <article class="prose body">
      <slot />
    </article>

    <section class="prose finish">
      <button class="btn primary" id="doneBtn" data-id={topic.id}>✓ أنهيت هذا الدرس</button>
    </section>

    <nav class="prose links">
      <div>
        <h3>تحتاج قبله</h3>
        {prereqs.length === 0 && <p class="none">لا شيء — نقطة انطلاق مناسبة.</p>}
        <ul>
          {prereqs.map(linkOrSpan).map(({ href, t }) => (
            <li>{href ? <a href={href}>{t.id}. {t.title}</a> : <span>{t.id}. {t.title} <em>قريبًا</em></span>}</li>
          ))}
        </ul>
      </div>
      <div>
        <h3>يقودك إلى</h3>
        <ul>
          {next.map(linkOrSpan).map(({ href, t }) => (
            <li>{href ? <a href={href}>{t.id}. {t.title}</a> : <span>{t.id}. {t.title} <em>قريبًا</em></span>}</li>
          ))}
        </ul>
      </div>
    </nav>

    <nav class="prose pager">
      {prev ? (prev.ready ? <a href={lessonUrl(prev)}>→ {prev.title}</a> : <span>→ {prev.title}</span>) : <span />}
      {after && (after.ready ? <a href={lessonUrl(after)}>{after.title} ←</a> : <span>{after.title} (قريبًا) ←</span>)}
    </nav>
  </main>
</Base>

<script>
  const btn = document.getElementById('doneBtn') as HTMLButtonElement;
  const id = Number(btn.dataset.id);
  const read = (): number[] => {
    try { return JSON.parse(localStorage.getItem('done') || '[]'); } catch (e) { return []; }
  };
  const render = () => {
    const done = read().includes(id);
    btn.textContent = done ? '✓ أنهيته — اضغط للتراجع' : '✓ أنهيت هذا الدرس';
    btn.classList.toggle('primary', !done);
  };
  btn.addEventListener('click', () => {
    const list = read();
    const next = list.includes(id) ? list.filter((x) => x !== id) : [...list, id];
    try { localStorage.setItem('done', JSON.stringify(next)); } catch (e) {}
    render();
  });
  render();
</script>

<style>
  .lesson-head {
    padding: 36px 0 32px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--c) 14%, var(--bg)) 0%, var(--bg) 100%);
    border-bottom: 1px solid var(--line);
  }
  .back { text-decoration: none; font-size: 15px; color: var(--muted); }
  .meta { color: var(--muted); font-size: 15px; margin: 18px 0 4px; display: flex; gap: 10px; align-items: center; }
  .badge { background: var(--c); color: #12121a; font-weight: 700; padding: 1px 12px; border-radius: 99px; font-size: 13px; }
  h1 { font-size: clamp(32px, 6vw, 48px); margin: 0; font-weight: 800; }
  .en { color: var(--muted); margin: 0 0 20px; text-align: right; font-size: 16px; }
  .idea {
    margin: 0; padding: 16px 20px; font-size: 20px; font-weight: 500;
    background: var(--surface); border-inline-start: 4px solid var(--c); border-radius: 12px;
  }
  .idea span { display: block; font-size: 13px; color: var(--c); font-weight: 700; }

  .body :global(h2) {
    margin-top: 56px; font-size: 26px; display: flex; align-items: center; gap: 12px;
  }
  .body :global(h2)::before {
    content: ''; width: 10px; height: 26px; border-radius: 4px; background: var(--c); flex: none;
  }
  .body :global(blockquote) {
    margin: 20px 0; padding: 4px 20px; border-inline-start: 3px solid var(--line); color: var(--muted);
  }
  .body :global(strong) { color: var(--text); }

  .finish { margin-top: 48px; text-align: center; }
  .links {
    display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 32px;
  }
  .links > div { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 18px; }
  .links h3 { margin: 0 0 6px; font-size: 16px; color: var(--c); }
  .links ul { margin: 0; padding: 0; list-style: none; font-size: 16px; }
  .links em { font-style: normal; font-size: 12px; color: var(--muted); }
  .links span { color: var(--muted); }
  .none { margin: 0; color: var(--muted); font-size: 15px; }
  .pager { display: flex; justify-content: space-between; margin-top: 24px; font-size: 15px; color: var(--muted); }
  .pager a { text-decoration: none; }
  @media (max-width: 560px) { .links { grid-template-columns: 1fr; } }
</style>
